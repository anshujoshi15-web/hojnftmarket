NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=798a4c4e5870335d10cd2621358e0f77
# Optional: enables the Blockscout multichain NFT fallback when a network's
# public explorer blocks server requests (for example, Robinhood Chain).
BLOCKSCOUT_API_KEY=
# Recommended for complete Ethereum, Polygon, Base, Robinhood, ApeChain, and Zora wallet holdings.
# Create one key in the Alchemy dashboard and add it to the deployed environment.
ALCHEMY_API_KEY=
# Local/durable Node server only. Default: .data/marketplace.sqlite.
# Set this to a persistent volume path in a self-hosted production server.
# Serverless environments need a persistent database integration, not /tmp.
MARKETPLACE_DB_PATH=

# Earlier V7 listings remain available through /legacy.
BASE_LEGACY_MARKETPLACE_ADDRESS=0x50489Fdc2352917595359667b34b384b33184b91
BASE_LEGACY_MARKETPLACE_DEPLOY_BLOCK=51813478

# MARKETPLACE_* are Shibarium-only aliases. Prefer the chain-specific values.
MARKETPLACE_ADDRESS=0xfb985d4eDd4C1F909899389C217aEC9D6895B72d
MARKETPLACE_DEPLOY_BLOCK=19188433
SHIBARIUM_LEGACY_MARKETPLACE_ADDRESS=0x455DaD76334a67660D61bb319d8CfF1010e33049
SHIBARIUM_LEGACY_MARKETPLACE_DEPLOY_BLOCK=19169320
SHIBARIUM_RPC_URL=https://rpc.shibarium.shib.io
# RPC ownership fallback scans incoming ERC-721 transfers over this many recent
# blocks and verifies every candidate with ownerOf before returning it.
SHIBARIUM_RPC_SCAN_BLOCKS=5000000

# Add these after deploying the marketplace contract to Ethereum mainnet.
ETHEREUM_MARKETPLACE_ADDRESS=
ETHEREUM_MARKETPLACE_DEPLOY_BLOCK=
